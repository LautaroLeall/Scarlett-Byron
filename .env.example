# ==============================================================================
# Plantilla de variables de entorno (segura para Git — SIN datos reales)
# Copia este archivo como `.env` para trabajar en local y carga las mismas
# variables en Vercel (Project Settings > Environment Variables).
# ==============================================================================

# URL de la Aplicación Web de Google Apps Script (Google Drive / Sheets)
# Guía paso a paso: docs/GUIA_GOOGLE_DRIVE.md
VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REEMPLAZAR_CON_TU_ID/exec

# Dominio público final de producción (sin barra final) para SEO y vista previa de WhatsApp.
# En Vercel se detecta automáticamente vía VERCEL_PROJECT_PRODUCTION_URL.
VITE_SITE_URL=https://scarlett-byron.vercel.app
